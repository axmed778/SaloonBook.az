# ----------------------------------------------------------------------------
# SalonBook.az environment
# Copy to .env and fill in. Never commit .env.
# ----------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# The app expects timestamptz; all app logic stores UTC.
#
# TWO URLs, and which one is which MATTERS on Neon (see prisma/schema.prisma):
#
#   DATABASE_URL -> POOLED endpoint, used for every RUNTIME query.
#     On Neon this is the hostname WITH "-pooler" in it, e.g.
#       ep-cool-name-123456-pooler.eu-central-1.aws.neon.tech
#     Client connections terminate at Neon's PgBouncer instead of at the
#     compute, so the compute sees few short-lived backend connections and can
#     actually reach its 5-minute autosuspend window. Pointing runtime traffic
#     at the direct endpoint is what makes a lightly-used project burn CU-hours
#     around the clock.
#     Append BOTH:
#       ?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=10
#     - pgbouncer=true      Prisma stops using named prepared statements, which
#                           transaction-mode pooling cannot carry. Without it you
#                           get intermittent 'prepared statement "s0" already
#                           exists' errors under load.
#     - connection_limit=5  Prisma otherwise opens num_cpus*2+1 connections PER
#                           CLIENT PER PROCESS (web + worker are separate).
#
#   DIRECT_URL -> DIRECT/unpooled endpoint, used ONLY by `prisma migrate` /
#     `prisma db push` / introspection (schema.prisma's `directUrl`). Same host
#     WITHOUT "-pooler". Migrations take advisory locks and run DDL that must
#     stay on one real backend connection, which a transaction pooler breaks.
#     The generated client never opens this at runtime.
#
# On a non-Neon Postgres (local dev, Railway Postgres, embedded-pg) there is no
# pooled/direct split — set both to the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salonbook?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/salonbook?schema=public"

# Optional, WEB SERVICE ONLY (never the worker). Points withTenantScope at the
# restricted `salonbook_app` role so the RLS policies actually deny rows — see
# "Security & tenant isolation" in README.md. Unset => withTenantScope uses the
# ordinary DATABASE_URL connection, i.e. today's behaviour. Deleting this
# variable is the rollback.
# This is a SECOND pool against the same database, so on Neon it must use the
# POOLED ("-pooler") host too, with the same pgbouncer/connection_limit params.
# RLS_DATABASE_URL="postgresql://salonbook_app:...@host-pooler.../db?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=10"

# --- Redis (queue + cache + locks) ---
REDIS_URL="redis://localhost:6379"

# --- Worker sweep cadence (worker service only; optional) ---
# Both timers run a query against Postgres on EVERY tick, so on a scale-to-zero
# database (Neon) their cadence — not their cost — decides whether the compute
# ever gets 5 uninterrupted idle minutes to autosuspend. Defaults below are the
# historical values; raise them to buy idle time, or set 0 to disable a timer.
#
# Stuck-QUEUED-notification re-enqueue. A self-healing fallback for a Redis
# hiccup, NOT the primary delivery path — raising this only delays recovery
# from an incident. Default 600000 (10 min).
# NOTIFICATION_SWEEP_INTERVAL_MS="3600000"
#
# Auto-complete appointments the salon never reconciled. The cutoff is 48h, so
# hourly is already far more often than the feature needs. Default 3600000 (1h).
# RECONCILE_INTERVAL_MS="21600000"

# --- Auth (local email/password) ---
# Signs the session cookie (HMAC-SHA256). REQUIRED in production: the app refuses
# to boot without it (see src/lib/env.ts) so sessions are never signed with the
# public dev fallback. Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# --- Seed (prisma/seed.ts) ---
# Password for the platform-admin account the seed creates on a fresh DB. Required
# only when the admin doesn't yet exist; never commit a real value. Must satisfy
# the signup policy (8+ chars, upper, lower, digit, special).
SEED_ADMIN_PASSWORD=""

# --- WhatsApp (Meta Cloud API) ---
# Leave WHATSAPP_TOKEN empty in dev to run the notification sender in sandbox
# mode (messages are logged, not sent).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="change-me-dev-verify-token"
WHATSAPP_APP_SECRET=""
# Encrypts per-salon "own number" WhatsApp access tokens at rest (AES-256-GCM,
# src/lib/crypto.ts). Only needed to activate a salon's own number (PRO feature).
# Any high-entropy string; generate with: openssl rand -base64 48
# WARNING: rotating this makes already-stored salon tokens undecryptable (they'd
# need to be re-entered in the admin panel).
WHATSAPP_ENCRYPTION_KEY=""

# --- Instagram Direct (Instagram API with Instagram Login) ---
# A SEPARATE Meta app from the WhatsApp one, with its own credentials. Outgoing
# calls go to https://graph.instagram.com/v21.0 (not graph.facebook.com).
#
# IG_APP_SECRET is the INSTAGRAM app's secret and is NOT WHATSAPP_APP_SECRET.
# The two webhooks are signed with different keys; crossing them rejects every
# delivery. Webhook endpoint: POST/GET /api/ig/webhook
IG_USER_ID=""
IG_APP_ID=""
IG_APP_SECRET=""
# Bootstrap long-lived token. After the first monthly refresh the live token is
# the one stored in the IgToken table (src/lib/ig-token.ts) — Meta hands back a
# NEW string on refresh and nothing can write it back here, so the DB is the
# source of truth and this stays the fallback for a fresh database.
IG_ACCESS_TOKEN=""
# Echoed back on Meta's GET verification handshake. Any string you also paste
# into the app's webhook configuration.
IG_VERIFY_TOKEN=""

# --- Cloudflare Turnstile (bot protection on the public booking form) ---
# Leave the secret empty to disable CAPTCHA verification in dev. When set, the
# public /book endpoint requires a valid `turnstileToken` from the form widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Cloudflare R2 (file storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="salonbook"

# --- Client phone-OTP sign-in (public client accounts) ---
# Codes are delivered over WhatsApp first (reuses WHATSAPP_TOKEN /
# WHATSAPP_PHONE_NUMBER_ID above; needs a Meta-approved authentication template),
# with SMS as a fallback. Optional pepper for hashing OTP codes in Redis — falls
# back to SESSION_SECRET when unset, so it's not required.
OTP_PEPPER=""
# Name of the approved Meta WhatsApp authentication template (default: otp_code).
WHATSAPP_OTP_TEMPLATE="otp_code"
# SMS fallback via Twilio (leave empty to disable SMS; WhatsApp still works).
# Swap this adapter (src/lib/otp-sender.ts) for a local AZ gateway if preferred.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Web Push (installable PWA notifications) ---
# VAPID keypair for Web Push. Generate once with:
#   npx web-push generate-vapid-keys
# Leave empty in dev: the push sender runs in sandbox (log-only) mode and the
# Settings "notifications" toggle hides itself. VAPID_SUBJECT is a contact URL
# (mailto: or https:) push services may use to reach the sender.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@salonbook.az"

# --- App ---
# Used for building public booking links: {APP_URL}/{slug}
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Email (Resend, for password reset) ---
# Leave RESEND_API_KEY empty in dev: reset emails are logged, not sent.
# EMAIL_FROM must be a Resend-verified sender in production.
RESEND_API_KEY=""
EMAIL_FROM="SalonBook <onboarding@resend.dev>"
