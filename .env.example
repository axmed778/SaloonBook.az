# ----------------------------------------------------------------------------
# SalonBook.az environment
# Copy to .env and fill in. Never commit .env.
# ----------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# Railway/local. The app expects timestamptz; all app logic stores UTC.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salonbook?schema=public"

# Optional, WEB SERVICE ONLY (never the worker). Points withTenantScope at the
# restricted `salonbook_app` role so the RLS policies actually deny rows — see
# "Security & tenant isolation" in README.md. Unset => withTenantScope uses the
# ordinary DATABASE_URL connection, i.e. today's behaviour. Deleting this
# variable is the rollback.
# RLS_DATABASE_URL="postgresql://salonbook_app:...@host:5432/db?connection_limit=5&pool_timeout=10"

# --- Redis (queue + cache + locks) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (local email/password) ---
# Signs the session cookie (HMAC-SHA256). REQUIRED in production: the app refuses
# to boot without it (see src/lib/env.ts) so sessions are never signed with the
# public dev fallback. Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# --- Seed (prisma/seed.ts) ---
# Password for the platform-admin account the seed creates on a fresh DB. Required
# only when the admin doesn't yet exist; never commit a real value. Must satisfy
# the signup policy (8+ chars, upper, lower, digit, special).
SEED_ADMIN_PASSWORD=""

# --- WhatsApp (Meta Cloud API) ---
# Leave WHATSAPP_TOKEN empty in dev to run the notification sender in sandbox
# mode (messages are logged, not sent).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="change-me-dev-verify-token"
WHATSAPP_APP_SECRET=""
# Encrypts per-salon "own number" WhatsApp access tokens at rest (AES-256-GCM,
# src/lib/crypto.ts). Only needed to activate a salon's own number (PRO feature).
# Any high-entropy string; generate with: openssl rand -base64 48
# WARNING: rotating this makes already-stored salon tokens undecryptable (they'd
# need to be re-entered in the admin panel).
WHATSAPP_ENCRYPTION_KEY=""

# --- Cloudflare Turnstile (bot protection on the public booking form) ---
# Leave the secret empty to disable CAPTCHA verification in dev. When set, the
# public /book endpoint requires a valid `turnstileToken` from the form widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Cloudflare R2 (file storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="salonbook"

# --- Client phone-OTP sign-in (public client accounts) ---
# Codes are delivered over WhatsApp first (reuses WHATSAPP_TOKEN /
# WHATSAPP_PHONE_NUMBER_ID above; needs a Meta-approved authentication template),
# with SMS as a fallback. Optional pepper for hashing OTP codes in Redis — falls
# back to SESSION_SECRET when unset, so it's not required.
OTP_PEPPER=""
# Name of the approved Meta WhatsApp authentication template (default: otp_code).
WHATSAPP_OTP_TEMPLATE="otp_code"
# SMS fallback via Twilio (leave empty to disable SMS; WhatsApp still works).
# Swap this adapter (src/lib/otp-sender.ts) for a local AZ gateway if preferred.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Web Push (installable PWA notifications) ---
# VAPID keypair for Web Push. Generate once with:
#   npx web-push generate-vapid-keys
# Leave empty in dev: the push sender runs in sandbox (log-only) mode and the
# Settings "notifications" toggle hides itself. VAPID_SUBJECT is a contact URL
# (mailto: or https:) push services may use to reach the sender.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@salonbook.az"

# --- App ---
# Used for building public booking links: {APP_URL}/{slug}
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Email (Resend, for password reset) ---
# Leave RESEND_API_KEY empty in dev: reset emails are logged, not sent.
# EMAIL_FROM must be a Resend-verified sender in production.
RESEND_API_KEY=""
EMAIL_FROM="SalonBook <onboarding@resend.dev>"
